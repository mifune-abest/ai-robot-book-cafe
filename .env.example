# AI ROBOT BOOK CAFE の安全な設定例
#
# このファイルに実際のAPIキーや秘密鍵を書かないでください。
# Node.js本体は .env を自動では読み込みません。
# 推奨起動の ./scripts/start.command が .env を読み込み、事前確認とログ保存も行います。

# 子ども用Webサーバー。同じLANのPCから開くための既定値です。
HOST=0.0.0.0
PORT=4310

# Macホスト専用画面のポートです。サーバー側で127.0.0.1だけに制限されます。
HOST_PORT=4311

# 受付内容、画像、素材写真のローカル保存先です。
DATA_DIR=./data

# 会話AIはCodex app-serverからGPTを使用します。
# Codex CLIのログイン状態を利用し、ローカルAIや別モデルへは切り替えません。
CODEX_COMMAND=codex
CODEX_APP_SERVER_MODEL=gpt-5.5
AI_TIMEOUT_MS=180000
IMAGE_TIMEOUT_MS=300000

# 4台テスト向けの同時実行数です。負荷やエラーが増える場合は1へ戻します。
# 安全のため、コード側では1〜4の範囲に制限します。
IMAGE_CONCURRENCY=2
TEXT_CONCURRENCY=2

# 安全な既定値はmockです。成人だけで実画像テストするときはcodexへ変更します。
# Codex組み込み画像生成はgpt-image-2を使用し、APIキーは不要です。
IMAGE_PROVIDER=mock

# IMAGE_PROVIDER=codexと組み合わせる場合だけtrueにします。
# このモードでは写真・素材・入力文がCodex経由でOpenAIへ送信されます。
# 未成年者が参加する前にfalseへ戻し、実画像生成を停止してください。
ADULT_TEST_MODE=false

# 両方が設定された場合だけ、子ども用サーバーがHTTPSになります。
# 証明書と信頼ストアの設定は未実施で、変更には明示許可が必要です。
TLS_CERT_PATH=
TLS_KEY_PATH=

# 本番では0のままにします。1は自動テスト専用です。
APP_TEST_MODE=0
